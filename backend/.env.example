NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/student-attendance
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
# Keep false in production. Provision teachers through an admin/institution workflow.
ALLOW_PUBLIC_TEACHER_SIGNUP=false
